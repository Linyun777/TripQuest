# Copy outside the repository; restrict the real file to its owner (chmod 600).
# Select an exact locally built/pushed image. Never use latest for a release.
TRIPQUEST_APP_IMAGE=
TRIPQUEST_MODEL_PROFILE_FILE=
TRIPQUEST_DEPLOY_STATE_DIR=
TRIPQUEST_BACKUP_DIR=
SITE_HOST=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

POSTGRES_USER=tripquest
POSTGRES_PASSWORD=
POSTGRES_DB=tripquest
# Container hostname is postgres; percent-encode special characters in the password.
DATABASE_URL=

TRIPQUEST_DEPLOYMENT_MODE=invited
PLANNING_PLACE_SOURCE=amap
REAL_PLACE_SAVE_ENABLED=true
PLANNING_GENERATION_ENABLED=true
PLANNING_AMAP_GENERATION_ENABLED=true
PLANNING_AMAP_MODEL_ENABLED=false
PLANNING_MODEL_MODE=live
PLANNING_LIVE_ROUND=disabled
PLANNING_SAVE_ENABLED=true
PLANNING_PLACE_TOKEN_SECRET=
PLANNING_DRAFT_RECEIPT_SECRET=
AGENT_LIVE_ENABLED=true
AGENT_MODEL_PROFILE=
AMAP_WEB_SERVICE_KEY=
PLANNING_MAP_MODE=amap
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=

# Match apiKeyEnv in the selected model profile; other vendors can add their variable.
DEEPSEEK_API_KEY=
WEB_SEARCH_ENABLED=true
KNOWLEDGE_ENABLED=true
DASHSCOPE_API_KEY=
INTENT_ROUTER=regex+deepseek
SHORT_PICKER=deepseek
OUTING_REVIEW=single
MODEL_DAILY_LIMIT=300
USER_DAILY_LIMIT_MODEL=100
USER_DAILY_LIMIT_AMAP=1000
USER_DAILY_LIMIT_WEB=50
USER_DAILY_LIMIT_EMBED=300
USER_DAILY_LIMIT_JEV=0
WEB_SEARCH_DAILY_LIMIT=100
EMBEDDING_DAILY_LIMIT=1000
JEV_DAILY_LIMIT=0

# Real conversation jobs run in Web. Enable this only with the optional worker profile
# if fixture tasks are also needed; the deployment script starts that worker for you.
PLANNING_TASKS_ENABLED=false
WORKER_CONCURRENCY=1

# Optional private directory, mounted read-only at /app/cost-config.
TRIPQUEST_COST_CONFIG_DIR=
MODEL_BILLING_CHANNEL=default
MODEL_PRICE_FILE=
FIXED_EXPENSE_FILE=
