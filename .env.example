# Local development only. Copy to .env; never commit real credentials.
# Compose project: tripquest-public; local database port: 55433.
POSTGRES_USER=tripquest
POSTGRES_PASSWORD=tripquest_local_dev
POSTGRES_DB=tripquest
POSTGRES_PORT=55433
DATABASE_URL=postgresql://tripquest:tripquest_local_dev@127.0.0.1:55433/tripquest
TEST_DATABASE_URL=postgresql://tripquest:tripquest_local_dev@127.0.0.1:55433/tripquest_test

# Development-only provider lab. Keep server keys out of NEXT_PUBLIC_ variables.
AMAP_LIVE_ENABLED=false
AMAP_WEB_SERVICE_KEY=

# Live model calls require opt-in and agent-models.local.json copied from the example.
AGENT_LIVE_ENABLED=false
AGENT_MODEL_PROFILE=deepseek-flash
DEEPSEEK_API_KEY=

# Optional web search; uses DEEPSEEK_API_KEY and has its own daily limit.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_DAILY_LIMIT=100

# Optional knowledge base: pnpm rag:ingest calls the embedding service.
DASHSCOPE_API_KEY=
KNOWLEDGE_ENABLED=true
EMBEDDING_DAILY_LIMIT=1000

# Router: regex (default), deepseek, embedding, cascade or jev.
INTENT_ROUTER=regex

# Optional Jev integration; data goes to TypeSafe only when selected.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0

# Short-trip candidate selector: deepseek (default) or jev.
SHORT_PICKER=deepseek
JEV_DAILY_LIMIT=500

# Outing review: on (default) or off.
OUTING_REVIEW=on

# Place selection: disabled (default), fixture (fictional), amap (development only).
PLANNING_PLACE_SOURCE=disabled

# Independent random secret, at least 32 UTF-8 bytes; server only.
PLANNING_PLACE_TOKEN_SECRET=

# Draft generation: scripted demo or live (development only).
PLANNING_GENERATION_ENABLED=false
PLANNING_MODEL_MODE=scripted

# Fixture/live evaluation opt-in: disabled, developer or independent-test.
PLANNING_LIVE_ROUND=disabled

# Additional opt-ins for the advanced real-place generation page.
PLANNING_AMAP_GENERATION_ENABLED=false
PLANNING_AMAP_MODEL_ENABLED=false

# Confirmed draft saving requires PostgreSQL and a receipt secret.
PLANNING_SAVE_ENABLED=false

# Personal real mode: development only; also requires PLANNING_PLACE_SOURCE=amap
# and AMAP_WEB_SERVICE_KEY. Chat additionally needs AGENT_LIVE_ENABLED=true, a
# model profile and API key. Saving needs PLANNING_SAVE_ENABLED=true and the
# receipt secret below. Stores only place IDs/names and our plans.
# Delete local real-place journeys/conversations: pnpm real-places:purge --yes
REAL_PLACE_SAVE_ENABLED=false

# Independent random secret, at least 32 UTF-8 bytes; server only.
PLANNING_DRAFT_RECEIPT_SECRET=

# Fixture/live replan evaluation opt-in: disabled, developer or independent-test.
REPLANNING_LIVE_ROUND=disabled

# Optional basemap: schematic (default) or amap. Separate JavaScript API key.
PLANNING_MAP_MODE=schematic
AMAP_JS_API_KEY=

# Matching securityJsCode; server only, supplied through the fixed proxy.
AMAP_JS_SECURITY_CODE=

# Durable fixture tasks in the worker. pnpm dev starts it when true.
# Real chat jobs are managed by the web app separately.
PLANNING_TASKS_ENABLED=true
WORKER_CONCURRENCY=2

# Development-only delay for observing fixture task recovery.
WORKER_FIXTURE_DELAY_MS=0

# Generate an independent random secret of at least 32 characters.
BETTER_AUTH_SECRET=

# Site address and trusted origin for auth cookies.
BETTER_AUTH_URL=http://localhost:3000

# Sign-in rate limit; always enabled in production.
AUTH_RATE_LIMIT=false

# Per-user daily limits (Asia/Shanghai). Owners can change individual limits
# with pnpm users limit. Optional Jev use is disabled per user by default.
USER_DAILY_LIMIT_MODEL=300
USER_DAILY_LIMIT_AMAP=1000
USER_DAILY_LIMIT_WEB=50
USER_DAILY_LIMIT_EMBED=300
USER_DAILY_LIMIT_JEV=0
