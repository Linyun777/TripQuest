# Local development only. Copy to .env; never commit real secrets.
# Public checkout uses its own Compose project, volume and port.
POSTGRES_USER=tripquest
POSTGRES_PASSWORD=tripquest_local_dev
POSTGRES_DB=tripquest
POSTGRES_PORT=55433
DATABASE_URL=postgresql://tripquest:tripquest_local_dev@127.0.0.1:55433/tripquest
TEST_DATABASE_URL=postgresql://tripquest:tripquest_local_dev@127.0.0.1:55433/tripquest_test

# Optional development-only Amap lab. Keys stay on the server; never use NEXT_PUBLIC_.
AMAP_LIVE_ENABLED=false
AMAP_WEB_SERVICE_KEY=

# Real model calls require explicit opt-in and agent-models.local.json.
AGENT_LIVE_ENABLED=false
AGENT_MODEL_PROFILE=deepseek-flash
DEEPSEEK_API_KEY=

# Web answers use the DeepSeek key, with a separate daily request limit.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_DAILY_LIMIT=100

# Knowledge retrieval uses DashScope embeddings/reranking. Populate with pnpm rag:ingest.
DASHSCOPE_API_KEY=
KNOWLEDGE_ENABLED=true
EMBEDDING_DAILY_LIMIT=1000

# Default: rules first, DeepSeek only when unsure; failures fall back to rules.
# Alternatives: regex, deepseek, embedding, cascade, jev.
INTENT_ROUTER=regex+deepseek

# Optional TypeSafe comparison. Data is sent there only when a Jev strategy is selected.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0

# Short-trip candidate selection: deepseek or jev.
SHORT_PICKER=deepseek
JEV_DAILY_LIMIT=500

# Outing review: single (default; on is an alias), off, or agent.
# agent enables experimental review/repair, whole-trip assessment and planning preferences.
OUTING_REVIEW=single

# Place selection: disabled, fixture (fictional), or amap (local development only).
PLANNING_PLACE_SOURCE=disabled

# Independent random secret, at least 32 UTF-8 bytes; server only.
PLANNING_PLACE_TOKEN_SECRET=

# Fictional one-day draft generation. scripted uses no model; live is development only.
# live also needs AGENT_LIVE_ENABLED, a model profile and an assigned budget round.
PLANNING_GENERATION_ENABLED=false
PLANNING_MODEL_MODE=scripted

# Live fixture evaluation round: disabled, developer or independent-test.
PLANNING_LIVE_ROUND=disabled

# Keep off unless real provider and model-processing conditions are confirmed.
PLANNING_AMAP_GENERATION_ENABLED=false
PLANNING_AMAP_MODEL_ENABLED=false

# Saving requires PostgreSQL and a separate receipt secret.
PLANNING_SAVE_ENABLED=false

# Personal real-place/chat mode: local development only. Requires amap place source,
# Amap and model configuration, PLANNING_SAVE_ENABLED and the receipt secret.
# Store only place IDs/names and your own plan; query provider details when displayed.
# Delete real-place plans and conversations with pnpm real-places:purge --yes.
REAL_PLACE_SAVE_ENABLED=false

# Independent random secret, at least 32 UTF-8 bytes; also signs progress/edit receipts.
PLANNING_DRAFT_RECEIPT_SECRET=

# Map display: schematic or optional development-only amap basemap.
# JavaScript key and security code are separate from the Web service key.
PLANNING_MAP_MODE=schematic
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=

# Durable fictional draft tasks. pnpm dev starts Web and Worker; real modes stream in Web.
PLANNING_TASKS_ENABLED=true
WORKER_CONCURRENCY=2

# Development-only fixture delay (ms), useful for observing task recovery.
WORKER_FIXTURE_DELAY_MS=0

# Invite-only accounts. Independent secret of at least 32 random characters.
BETTER_AUTH_SECRET=

# Site address and trusted origin.
BETTER_AUTH_URL=http://localhost:3000

# Sign-in rate limit. Always enabled in production.
AUTH_RATE_LIMIT=false

# Per-user daily limits (Beijing calendar day). Manage with pnpm users limit.
# Provider-wide limits remain separate.
USER_DAILY_LIMIT_MODEL=300
USER_DAILY_LIMIT_AMAP=1000
USER_DAILY_LIMIT_WEB=50
USER_DAILY_LIMIT_EMBED=300
USER_DAILY_LIMIT_JEV=0
